{
	"$schema": "typeflare/schema.json",
	"name": "example",
	"main": "./worker.ts",
	"compatibility_date": "2025-05-05",
	"compatibility_flags": ["nodejs_compat"],

	"d1_databases": [
		{
			"binding": "DATABASE",
			"database_name": "<d1-database-name>",
			"database_id": "<d1-database-id>"
		}
	],

	"typeflare": {
		"d1_databases": {
			"DATABASE": true
		}
	}
}
